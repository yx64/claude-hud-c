# Fails unless the executable imports from the allowed DLLs only and has no delay imports. Usage:
#   cmake -DREADOBJ=<LlvmReadobj> -DEXE=<Exe> -DALLOWED=<Dll>[;<Dll>...] -P CheckImports.cmake
foreach(v READOBJ EXE ALLOWED)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "CheckImports.cmake: pass -D${v}=...")
  endif()
endforeach()
execute_process(COMMAND ${READOBJ} --coff-imports ${EXE} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "llvm-readobj exited with ${rc} on ${EXE}")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(kind "")
set(imports "")
set(delay "")
foreach(line IN LISTS lines)
  if(line MATCHES "^(Import|DelayImport) {")
    set(kind ${CMAKE_MATCH_1})
  elseif(kind AND line MATCHES "^[ \t]*Name: ([^ \t]+\\.dll)")
    if(kind STREQUAL "Import")
      list(APPEND imports ${CMAKE_MATCH_1})
    else()
      list(APPEND delay ${CMAKE_MATCH_1})
    endif()
  endif()
endforeach()
if(NOT imports)
  message(FATAL_ERROR "no import read from ${EXE}, so the check proves nothing")
endif()
set(extra ${imports})
list(REMOVE_ITEM extra ${ALLOWED})
list(APPEND extra ${delay})
if(extra)
  message(FATAL_ERROR "${EXE} imports more than ${ALLOWED}: ${extra}")
endif()
