# Runs one group of the cases under test/cases through the test build and compares, byte for byte,
# what it prints and the files it writes with what upstream claude-hud printed and wrote for the
# same input. Usage:
#   cmake -DGROUP=<Group> -DBIN=<BuildDir> [-DSTAMP=<File>] [-DRESULT=<File>] -P run.cmake
#   cmake -DGROUP=<Group> -DBIN=<BuildDir> -DREFERENCE=<UpstreamDir> [-DNODE=<Node>] -P run.cmake
# The second form writes the expected files from upstream first: <UpstreamDir> is a claude-hud
# source tree of the version in compare/common.mjs, with its dist/ built; node 24 runs it. Each case
# is also run under other time zones (and, off Windows, another locale), and one whose output
# changes with them is refused: the expected files must hold on every machine. Off Windows, output
# that differs from expected.out goes to expected-posix.out, and on macOS output that differs from
# what applies to POSIX goes to expected-darwin.out.
#
# A case is a directory test/cases/<Group>/<Case>. Each file below is taken from the case directory,
# else from the group directory, else from test/cases, so that cases share what they have in common:
#   stdin.json         what Claude Code passes on stdin (required)
#   config.json        <CLAUDE_CONFIG_DIR>/plugins/claude-hud/config.json
#   transcript.jsonl   the session transcript, at @TRANSCRIPT@
#   transcript.repeat  a count: the transcript is that many copies of transcript.jsonl, made once per
#                      build directory, so large inputs need not be committed
#   env.txt            <Name>=<Value> lines, after the environment every refresh gets (common.cmake);
#                      unlike the others, those of all three levels apply, the case's last
# Only in the case directory:
#   claude/ home/ proj/  copied into CLAUDE_CONFIG_DIR, HOME and the cwd the stdin names (@PROJ@); a
#                      name dot-<Name> in them is copied as .<Name>. Dot files are what global ignore
#                      rules catch (.claude/settings.local.json is a common one), and a case file
#                      left out of a commit would pass on the machine that has it and fail elsewhere
#   setup.cmake        included after the copies, with HUD_DIR the work directory (a git repository
#                      and the like)
#   expected.out       the canonical stdout (common.cmake: hud_canon); expected-win32.out,
#                      expected-posix.out or expected-darwin.out instead where the platforms differ.
#                      macOS takes expected-darwin.out, else expected-posix.out, else expected.out
#   expected.files/    the canonical files the refresh writes under plugins/claude-hud (the config
#                      aside); none means it writes none. expected-win32.files/, expected-posix.files/
#                      or expected-darwin.files/ likewise
#   expected.err       instead of the two above: the test build exits 3 (input it does not reproduce
#                      exactly) with this text in its stderr; upstream is not asked
# Every case file holds the placeholders of common.cmake (hud_subst).
cmake_minimum_required(VERSION 3.28)
include(${CMAKE_CURRENT_LIST_DIR}/common.cmake)

set(cases_dir ${HUD_TEST_DIR}/cases/${GROUP})
if(NOT IS_DIRECTORY ${cases_dir})
  message(FATAL_ERROR "run.cmake: no group ${GROUP} under ${HUD_TEST_DIR}/cases")
endif()
set(hud_test ${BIN}/claude-hud-c-test${HUD_EXE_SUFFIX})
if(NOT EXISTS ${hud_test})
  message(FATAL_ERROR "run.cmake: missing ${hud_test}; build first")
endif()
# The platforms whose own expected files apply here, most specific first. macOS has its own where upstream
# prints something there only (process.platform "darwin"), and takes the POSIX ones otherwise.
if(CMAKE_HOST_WIN32)
  set(platforms win32)
elseif(CMAKE_HOST_APPLE)
  set(platforms darwin posix)
else()
  set(platforms posix)
endif()

if(DEFINED REFERENCE)
  if(NOT DEFINED NODE)
    find_program(NODE node REQUIRED)
  endif()
  if(NOT EXISTS ${REFERENCE}/dist/index.js)
    message(FATAL_ERROR "run.cmake: ${REFERENCE} has no dist/index.js; build the upstream source first")
  endif()
  hud_file_url(${HUD_TEST_DIR}/compare/fakeclock.mjs fakeclock)
  set(reference_cmd ${NODE} --import ${fakeclock} ${HUD_TEST_DIR}/compare/run-upstream.mjs ${REFERENCE})
  # Each must give the output of the plain run. Windows reads its locale from the system, not LANG.
  set(variants "TZ=Etc/GMT+11" "TZ=Etc/GMT-11")
  if(NOT CMAKE_HOST_WIN32)
    list(APPEND variants "LANG=zh_CN.UTF-8")
  endif()
endif()

# <Name> from the case directory, else the group directory, else test/cases itself, else empty.
function(case_file case name out)
  set(f "")
  foreach(d ${cases_dir}/${case} ${cases_dir} ${HUD_TEST_DIR}/cases)
    if(EXISTS ${d}/${name} AND f STREQUAL "")
      set(f ${d}/${name})
    endif()
  endforeach()
  set(${out} "${f}" PARENT_SCOPE)
endfunction()

# The variant of an expected file or directory for the first of <Platforms> that has one, else the common
# one.
function(expected_path_in platform_list case name ext out)
  set(p ${cases_dir}/${case}/${name}${ext})
  foreach(platform IN LISTS platform_list)
    if(EXISTS ${cases_dir}/${case}/${name}-${platform}${ext})
      set(p ${cases_dir}/${case}/${name}-${platform}${ext})
      break()
    endif()
  endforeach()
  set(${out} ${p} PARENT_SCOPE)
endfunction()

# The variant that applies here.
function(expected_path case name ext out)
  expected_path_in("${platforms}" ${case} ${name} ${ext} p)
  set(${out} ${p} PARENT_SCOPE)
endfunction()

# Prepares the work directory <Dir> for <Case>, runs one refresh there with the command after COMMAND
# and the extra environment after ENV, and leaves the canonical stdout in <Dir>/canonical.out and the
# canonical written files under <Dir>/canonical.files/. Sets in the caller: code, err, files (the
# written files' names), problem (empty, or why the output has no canonical form).
function(refresh case dir)
  cmake_parse_arguments(PARSE_ARGV 2 R "" "" "ENV;COMMAND")
  set(out ${dir}/canonical)
  hud_env_reset(${dir})
  foreach(kv IN LISTS R_ENV)
    string(REGEX MATCH "^([^=]+)=(.*)$" _ "${kv}")
    set(ENV{${CMAKE_MATCH_1}} "${CMAKE_MATCH_2}")
  endforeach()

  set(transcript ${dir}/transcript.jsonl)
  case_file(${case} transcript.repeat repeat)
  if(repeat)
    case_file(${case} transcript.jsonl unit)
    file(READ ${repeat} count)
    string(STRIP "${count}" count)
    file(READ ${unit} t)
    string(SHA256 key "${count}\n${t}")
    set(transcript ${BIN}/test-work/shared/${key}.jsonl)
  endif()
  hud_placeholders(${dir} ${transcript})
  if(repeat)
    if(NOT EXISTS ${transcript})
      hud_copy_subst(${unit} ${transcript}.part ${count})
      file(RENAME ${transcript}.part ${transcript})
    endif()
  else()
    case_file(${case} transcript.jsonl f)
    if(f)
      hud_copy_subst(${f} ${transcript})
    endif()
  endif()

  case_file(${case} stdin.json f)
  if(NOT f)
    message(FATAL_ERROR "run.cmake: ${GROUP}/${case} has no stdin.json")
  endif()
  hud_copy_subst(${f} ${dir}/stdin.json)
  case_file(${case} config.json f)
  if(f)
    hud_copy_subst(${f} ${dir}/claude/plugins/claude-hud/config.json)
  endif()
  foreach(sub claude home proj)
    file(GLOB_RECURSE copies RELATIVE ${cases_dir}/${case}/${sub} ${cases_dir}/${case}/${sub}/*)
    foreach(c IN LISTS copies)
      string(REGEX REPLACE "(^|/)dot-" "\\1." to "${c}")
      hud_copy_subst(${cases_dir}/${case}/${sub}/${c} ${dir}/${sub}/${to})
    endforeach()
  endforeach()
  foreach(f2 ${HUD_TEST_DIR}/cases/env.txt ${cases_dir}/env.txt ${cases_dir}/${case}/env.txt)
    if(EXISTS ${f2})
      file(READ ${f2} t)
      hud_subst("${t}" t)
      string(APPEND t "\n")
      while(NOT t STREQUAL "")
        string(FIND "${t}" "\n" nl)
        string(SUBSTRING "${t}" 0 ${nl} line)
        math(EXPR nl "${nl} + 1")
        string(SUBSTRING "${t}" ${nl} -1 t)
        if(line MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
          set(ENV{${CMAKE_MATCH_1}} "${CMAKE_MATCH_2}")
        elseif(NOT line STREQUAL "" AND NOT line MATCHES "^#")
          message(FATAL_ERROR "run.cmake: ${f2}: not <Name>=<Value>: ${line}")
        endif()
      endwhile()
    endif()
  endforeach()
  if(EXISTS ${cases_dir}/${case}/setup.cmake)
    set(HUD_DIR ${dir})
    include(${cases_dir}/${case}/setup.cmake)
  endif()

  execute_process(COMMAND ${R_COMMAND} INPUT_FILE ${dir}/stdin.json OUTPUT_FILE ${dir}/stdout ERROR_VARIABLE e
                  RESULT_VARIABLE c WORKING_DIRECTORY ${dir}/proj TIMEOUT ${HUD_RUN_TIMEOUT})
  hud_canon(${dir}/stdout ${out}.out problem)

  set(written ${dir}/claude/plugins/claude-hud)
  file(GLOB_RECURSE names RELATIVE ${written} ${written}/*)
  list(REMOVE_ITEM names config.json)
  string(SHA256 tsha "${HUD_NATIVE_TRANSCRIPT}")
  set(files "")
  foreach(n IN LISTS names)
    string(REPLACE "${tsha}" "@TRANSCRIPT_SHA256@" cn "${n}")
    hud_canon(${written}/${n} ${out}.files/${cn} p)
    if(p)
      set(problem "${n} ${p}")
    endif()
    list(APPEND files ${cn})
  endforeach()
  list(SORT files)
  string(REPLACE "\r\n" "\n" e "${e}")
  string(STRIP "${e}" e)
  set(code "${c}" PARENT_SCOPE)
  set(err "${e}" PARENT_SCOPE)
  set(files "${files}" PARENT_SCOPE)
  set(problem "${problem}" PARENT_SCOPE)
endfunction()

# The files under <Dir>, relative and sorted.
function(list_files dir out)
  set(names "")
  if(IS_DIRECTORY ${dir})
    file(GLOB_RECURSE names RELATIVE ${dir} ${dir}/*)
    list(SORT names)
  endif()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

# A file's text as an expected file holds it: any carriage return is a checkout's, not the case's.
function(read_expected file out)
  file(READ ${file} t)
  string(REPLACE "\r" "" t "${t}")
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# Writes the expected files of <Case> from the reference run left in <Out>.
function(update_expected case out)
  list(GET platforms 0 platform)
  set(own_out ${cases_dir}/${case}/expected-${platform}.out)
  set(own_files ${cases_dir}/${case}/expected-${platform}.files)
  if(NOT EXISTS ${own_out})
    # What applies here while this platform has none of its own: on macOS the POSIX variant, else the
    # common one.
    set(inherited ${platforms})
    list(REMOVE_AT inherited 0)
    expected_path_in("${inherited}" ${case} expected .out base_out)
    expected_path_in("${inherited}" ${case} expected .files base_files)
    # Off Windows, output unlike that becomes the platform's own.
    set(keep_base TRUE)
    if(NOT CMAKE_HOST_WIN32 AND EXISTS ${base_out})
      read_expected(${base_out} common)
      file(READ ${out}.out now)
      if(NOT common STREQUAL now)
        set(keep_base FALSE)
        get_filename_component(base_name ${base_out} NAME)
        hud_warn("${case}: output differs from ${base_name} here; written to expected-${platform}.out")
      endif()
    endif()
    if(keep_base)
      set(own_out ${base_out})
      set(own_files ${base_files})
    endif()
  endif()
  file(COPY_FILE ${out}.out ${own_out})
  list_files(${out}.files now)
  list_files(${own_files} before)
  foreach(n IN LISTS before)
    if(NOT n IN_LIST now)
      hud_fail(${case} "${own_files}/${n} is no longer written by upstream; remove it by hand")
    endif()
  endforeach()
  foreach(n IN LISTS now)
    get_filename_component(d ${own_files}/${n} DIRECTORY)
    file(MAKE_DIRECTORY ${d})
    file(COPY_FILE ${out}.files/${n} ${own_files}/${n})
  endforeach()
endfunction()

# Whether two runs left the same canonical output.
function(same_run a b out)
  file(READ ${a}.out ta)
  file(READ ${b}.out tb)
  list_files(${a}.files fa)
  list_files(${b}.files fb)
  set(same FALSE)
  if(ta STREQUAL tb AND fa STREQUAL fb)
    set(same TRUE)
    foreach(n IN LISTS fa)
      file(READ ${a}.files/${n} x)
      file(READ ${b}.files/${n} y)
      if(NOT x STREQUAL y)
        set(same FALSE)
      endif()
    endforeach()
  endif()
  set(${out} ${same} PARENT_SCOPE)
endfunction()

function(run_case case)
  set(cdir ${cases_dir}/${case})
  set(dir ${HUD_RUN}/test/${GROUP}/${case})
  set(out ${dir}/canonical)
  set(want_err "")
  if(EXISTS ${cdir}/expected.err)
    read_expected(${cdir}/expected.err want_err)
    string(STRIP "${want_err}" want_err)
  endif()

  if(DEFINED REFERENCE AND want_err STREQUAL "")
    set(ref ${HUD_RUN}/reference/${GROUP}/${case}/canonical)
    refresh(${case} ${HUD_RUN}/reference/${GROUP}/${case} COMMAND ${reference_cmd})
    if(problem OR NOT code EQUAL 0)
      hud_fail(${case} "upstream exited ${code}: ${problem}" "\n     ${err}")
      return()
    endif()
    set(k 0)
    foreach(v IN LISTS variants)
      math(EXPR k "${k} + 1")
      set(var ${HUD_RUN}/variant-${k}/${GROUP}/${case}/canonical)
      refresh(${case} ${HUD_RUN}/variant-${k}/${GROUP}/${case} ENV ${v} COMMAND ${reference_cmd})
      same_run(${ref} ${var} same)
      if(NOT same)
        hud_fail(${case} "upstream output changes with ${v}; make the case independent of it" "\n     diff ${ref}.out ${var}.out")
        return()
      endif()
    endforeach()
    update_expected(${case} ${ref})
  endif()

  refresh(${case} ${dir} COMMAND ${hud_test})
  if(code EQUAL 3 AND err MATCHES "locale or time zone not reproduced")
    hud_skip(${case} "the system locale or time zone is one the test build does not reproduce")
    return()
  endif()
  if(NOT want_err STREQUAL "")
    string(FIND "${err}" "${want_err}" at)
    if(NOT code EQUAL 3 OR at EQUAL -1)
      hud_fail(${case} "expected exit 3 with \"${want_err}\", got exit ${code}" "\n     stderr ${err}")
    else()
      hud_pass(${case})
    endif()
    return()
  endif()
  if(NOT code EQUAL 0)
    hud_fail(${case} "exit ${code}" "\n     stderr ${err}")
    return()
  endif()
  if(problem)
    hud_fail(${case} "the output ${problem}")
    return()
  endif()

  expected_path(${case} expected .out want)
  if(NOT EXISTS ${want})
    hud_fail(${case} "no ${want}; write it with -DREFERENCE=<UpstreamDir>")
    return()
  endif()
  read_expected(${want} a)
  file(READ ${out}.out b)
  if(NOT a STREQUAL b)
    hud_first_diff("${a}" "${b}" d)
    hud_fail(${case} "stdout differs" "${d}\n     diff ${want} ${out}.out")
    return()
  endif()

  expected_path(${case} expected .files want_files)
  list_files(${want_files} wf)
  if(NOT wf STREQUAL files)
    hud_fail(${case} "writes [${files}], expected [${wf}]" "\n     under ${out}.files")
    return()
  endif()
  foreach(n IN LISTS files)
    read_expected(${want_files}/${n} a)
    file(READ ${out}.files/${n} b)
    if(NOT a STREQUAL b)
      hud_first_diff("${a}" "${b}" d)
      hud_fail(${case} "written ${n} differs" "${d}\n     diff ${want_files}/${n} ${out}.files/${n}")
      return()
    endif()
  endforeach()
  hud_pass(${case})
endfunction()

file(GLOB entries LIST_DIRECTORIES true RELATIVE ${cases_dir} ${cases_dir}/*)
list(SORT entries)
foreach(case IN LISTS entries)
  if(IS_DIRECTORY ${cases_dir}/${case})
    hud_selected(${case} sel)
    if(sel)
      run_case(${case})
    endif()
  endif()
endforeach()
hud_finish()
