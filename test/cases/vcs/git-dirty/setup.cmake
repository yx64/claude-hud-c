# A repository in the cwd, with a fixed identity and fixed dates so that commit ids never change.
set(ENV{GIT_AUTHOR_NAME} t)
set(ENV{GIT_AUTHOR_EMAIL} t@t)
set(ENV{GIT_COMMITTER_NAME} t)
set(ENV{GIT_COMMITTER_EMAIL} t@t)
set(ENV{GIT_AUTHOR_DATE} "2026-10-10T10:00:00Z")
set(ENV{GIT_COMMITTER_DATE} "2026-10-10T10:00:00Z")
function(git)
  execute_process(COMMAND git ${ARGN} WORKING_DIRECTORY ${HUD_DIR}/proj OUTPUT_QUIET ERROR_VARIABLE err RESULT_VARIABLE code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "git ${ARGN}: ${err}")
  endif()
endfunction()
git(init -q -b main)
# The files are written with CRLF on Windows; the blobs, and so the commit ids, must not differ.
git(config core.autocrlf input)
foreach(f a.txt b.txt sub/c.txt)
  file(MAKE_DIRECTORY ${HUD_DIR}/proj/sub)
  file(WRITE ${HUD_DIR}/proj/${f} "one\ntwo\nthree\n")
endforeach()
git(add .)
git(commit -q -m init)
file(WRITE ${HUD_DIR}/proj/a.txt "one\n2\nthree\nfour\n")
git(mv b.txt b2.txt)
file(WRITE ${HUD_DIR}/proj/new.txt "x\n")
git(add new.txt)
file(WRITE ${HUD_DIR}/proj/untracked.txt "u\n")
