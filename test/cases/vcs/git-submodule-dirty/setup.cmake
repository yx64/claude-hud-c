# A repository in the cwd, with a fixed identity and fixed dates so that commit ids never change.
set(ENV{GIT_AUTHOR_NAME} t)
set(ENV{GIT_AUTHOR_EMAIL} t@t)
set(ENV{GIT_COMMITTER_NAME} t)
set(ENV{GIT_COMMITTER_EMAIL} t@t)
set(ENV{GIT_AUTHOR_DATE} "2026-10-10T10:00:00Z")
set(ENV{GIT_COMMITTER_DATE} "2026-10-10T10:00:00Z")
function(git_in dir)
  execute_process(COMMAND git ${ARGN} WORKING_DIRECTORY ${dir} OUTPUT_QUIET ERROR_VARIABLE err RESULT_VARIABLE code
                  TIMEOUT ${HUD_RUN_TIMEOUT})
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "git ${ARGN}: ${code} ${err}")
  endif()
endfunction()
# Uncommitted changes inside a submodule leave the repository clean.
file(MAKE_DIRECTORY ${HUD_DIR}/subsrc)
git_in(${HUD_DIR}/subsrc init -q -b main)
git_in(${HUD_DIR}/subsrc config core.autocrlf input)
file(WRITE ${HUD_DIR}/subsrc/x.txt "x\n")
git_in(${HUD_DIR}/subsrc add .)
git_in(${HUD_DIR}/subsrc commit -q -m sub)
git_in(${HUD_DIR}/proj init -q -b main)
git_in(${HUD_DIR}/proj config core.autocrlf input)
file(WRITE ${HUD_DIR}/proj/a.txt "one\n")
git_in(${HUD_DIR}/proj add .)
git_in(${HUD_DIR}/proj -c protocol.file.allow=always submodule add -q ${HUD_DIR}/subsrc sub)
git_in(${HUD_DIR}/proj commit -q -m init)
file(WRITE ${HUD_DIR}/proj/sub/x.txt "changed\n")
