# The saved parse state (src/transcript-state.c): a refresh that resumes from it must print exactly
# what a full parse prints. At every step the test build, resuming, is compared with the test build
# compiled without parse state (HUD_C_NO_TRANSCRIPT_STATE), which parses from the start each time.
# Upstream is not needed: the case groups (run.cmake) hold the full parse to upstream, this group holds
# resuming to the full parse. Usage:
#   cmake -DGROUP=cache -DBIN=<BuildDir> [-DSTAMP=<File>] [-DRESULT=<File>] -P cache.cmake
#
# Sections, each a name for HUD_TEST_ONLY=cache/<Section>:
#   lf crlf cr ls ps mixed  transcripts of cache/lines.jsonl ending their lines with \n, \r\n, \r,
#                     U+2028, U+2029, or all five in turn, grown in place cut point by cut point: at
#                     line ends, inside lines, right after a \r, inside a three-byte terminator. After
#                     each step the saved state must sit right after the last complete line
#   invalidate        the file rewritten in its first bytes or just before the saved offset, replaced
#                     by another file, cut shorter, the state file damaged or cut short: each must
#                     parse from the start
#   replaced          a replacing file that differs only between the two hashed windows: only its
#                     file identity tells
#   same-name         two transcripts with one file name, whose states share a name
#   unsupported       an unsupported case in the saved part is still reported when resuming
#   timeless          a tool line without a time takes the clock, so no state is saved past it
cmake_minimum_required(VERSION 3.28)
include(${CMAKE_CURRENT_LIST_DIR}/common.cmake)

set(hud_test ${BIN}/claude-hud-c-test${HUD_EXE_SUFFIX})
set(hud_full ${BIN}/claude-hud-c-test-nostate${HUD_EXE_SUFFIX})
foreach(exe ${hud_test} ${hud_full})
  if(NOT EXISTS ${exe})
    message(FATAL_ERROR "cache.cmake: missing ${exe}; build first")
  endif()
endforeach()
set(lines_file ${HUD_TEST_DIR}/cache/lines.jsonl)
file(READ ${lines_file} lines_text)
string(REPLACE "\r" "" lines_text "${lines_text}")

# The work directory of a section: its config, cwd and home; whole transcripts under full/, the ones
# grown in place under t/, saved states under state/.
macro(section name)
  set(dir ${HUD_RUN}/cache/${name})
  hud_env_reset(${dir})
  file(MAKE_DIRECTORY ${dir}/claude/plugins/claude-hud ${dir}/t ${dir}/full)
  file(COPY_FILE ${HUD_TEST_DIR}/cache/config.json ${dir}/claude/plugins/claude-hud/config.json)
  hud_placeholders(${dir} ${dir}/t)
endmacro()

# A lines file under the section with <Line> inserted before line <At> of cache/lines.jsonl (appended
# when <At> is past the end); further <At> <Line> pairs may follow.
function(lines_with out)
  set(text "${lines_text}")
  set(pairs ${ARGN})
  set(result "")
  set(i 0)
  while(NOT text STREQUAL "")
    string(FIND "${text}" "\n" nl)
    string(SUBSTRING "${text}" 0 ${nl} line)
    math(EXPR nl "${nl} + 1")
    string(SUBSTRING "${text}" ${nl} -1 text)
    foreach(k RANGE 0 9 2)
      list(LENGTH pairs n)
      if(k LESS n)
        list(GET pairs ${k} at)
        if(at EQUAL i)
          math(EXPR k1 "${k} + 1")
          list(GET pairs ${k1} extra)
          string(APPEND result "${extra}\n")
        endif()
      endif()
    endforeach()
    string(APPEND result "${line}\n")
    math(EXPR i "${i} + 1")
  endwhile()
  foreach(k RANGE 0 9 2)
    list(LENGTH pairs n)
    if(k LESS n)
      list(GET pairs ${k} at)
      if(NOT at LESS i)
        math(EXPR k1 "${k} + 1")
        list(GET pairs ${k1} extra)
        string(APPEND result "${extra}\n")
      endif()
    endif()
  endforeach()
  # file(WRITE) may turn \n into \r\n here; bytes join drops every \r.
  file(WRITE ${out} "${result}")
endfunction()

# The transcript of the lines in <Lines>, each ended by the terminator of <Mode>, written to <Dst>; its
# line ends, as <End>,<Length of the terminator>,<1 for a lone \r>, in <Ends>.
function(build lines mode dst ends_var)
  execute_process(COMMAND ${HUD_BYTES} join ${lines} ${dst} ${mode} OUTPUT_VARIABLE ends COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "\r" "" ends "${ends}")
  string(STRIP "${ends}" ends)
  string(REPLACE "\n" ";" ends "${ends}")
  set(${ends_var} "${ends}" PARENT_SCOPE)
endfunction()

# Where the saved state should be after a refresh of the first <Cut> bytes: right after the last line
# that is complete, as parse_transcript decides it; a \r at the very end may still become \r\n.
function(want_offset ends cut out)
  set(want 0)
  foreach(e IN LISTS ends)
    string(REPLACE "," ";" e "${e}")
    list(GET e 0 end)
    list(GET e 2 lone)
    if(end LESS cut OR (end EQUAL cut AND lone EQUAL 0))
      set(want ${end})
    endif()
  endforeach()
  set(${out} ${want} PARENT_SCOPE)
endfunction()

# The offset recorded in the state saved for <Transcript> under <State>, or empty when there is none:
# <State>/<Name>.bin for <Name>.jsonl, a little-endian 64-bit offset at byte 8 (Header in
# transcript-state.c).
function(saved_offset state transcript out)
  get_filename_component(name ${transcript} NAME_WE)
  set(f ${state}/${name}.bin)
  set(v "")
  if(EXISTS ${f})
    file(READ ${f} h OFFSET 8 LIMIT 8 HEX)
    set(be "")
    foreach(i 14 12 10 8 6 4 2 0)
      string(SUBSTRING "${h}" ${i} 2 b)
      string(APPEND be "${b}")
    endforeach()
    math(EXPR v "0x${be}" OUTPUT_FORMAT DECIMAL)
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# One refresh of <Transcript> by both builds; passes when they agree on exit code, output and, for an
# unsupported case, the reason.
function(check label transcript)
  file(TO_NATIVE_PATH "${transcript}" tp)
  string(REPLACE "\\" "\\\\" tp "${tp}")
  file(WRITE ${dir}/stdin.json "{\"session_id\":\"s\",\"transcript_path\":\"${tp}\",\"cwd\":\"${HUD_JSON_PROJ}\",\"model\":{\"id\":\"claude-opus-5-5\",\"display_name\":\"Opus\"},\"effort\":{\"level\":\"high\"}}")
  foreach(side "resumed;${hud_test}" "full;${hud_full}")
    list(GET side 0 s)
    list(GET side 1 exe)
    execute_process(COMMAND ${exe} INPUT_FILE ${dir}/stdin.json OUTPUT_FILE ${dir}/${s}.out ERROR_VARIABLE err_${s}
                    RESULT_VARIABLE code_${s} WORKING_DIRECTORY ${dir}/proj TIMEOUT ${HUD_RUN_TIMEOUT})
    string(STRIP "${err_${s}}" err_${s})
  endforeach()
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${dir}/resumed.out ${dir}/full.out RESULT_VARIABLE differ)
  if(code_resumed EQUAL 3 AND err_resumed MATCHES "locale or time zone not reproduced")
    hud_skip(${label} "the system locale or time zone is one the test build does not reproduce")
  elseif(NOT code_resumed STREQUAL code_full OR NOT (code_resumed EQUAL 0 OR code_resumed EQUAL 3))
    hud_fail(${label} "exit ${code_resumed} resuming, ${code_full} parsing in full" "\n     ${err_resumed}")
  elseif(code_resumed EQUAL 3 AND NOT err_resumed STREQUAL err_full)
    hud_fail(${label} "unsupported for another reason resuming" "\n     resumed ${err_resumed}\n     full    ${err_full}")
  elseif(differ)
    hud_canon(${dir}/full.out ${dir}/full.canonical p)
    hud_canon(${dir}/resumed.out ${dir}/resumed.canonical p)
    file(READ ${dir}/full.canonical a)
    file(READ ${dir}/resumed.canonical b)
    hud_first_diff("${a}" "${b}" d)
    string(REPLACE "expected" "full    " d "${d}")
    string(REPLACE "actual  " "resumed " d "${d}")
    hud_fail(${label} "resuming prints otherwise than a full parse" "${d}")
  else()
    hud_pass(${label})
  endif()
endfunction()

# Grows t/<Name>.jsonl in place from nothing to the bytes of <Full> through <Cuts>, the last one twice,
# checking at each step. The saved state must sit right after the last complete line of what has been
# written so far, or, given a limit as a further argument, never past it.
function(grow name full ends cuts)
  set(limit "")
  if(ARGC GREATER 4)
    set(limit ${ARGV4})
  endif()
  set(tp ${dir}/t/${name}.jsonl)
  file(WRITE ${tp} "")
  set(at 0)
  list(GET cuts -1 final)
  foreach(c IN LISTS cuts ITEMS ${final})
    if(c GREATER at)
      execute_process(COMMAND ${HUD_BYTES} append ${full} ${tp} ${at} ${c} COMMAND_ERROR_IS_FATAL ANY)
    endif()
    set(at ${c})
    check("${name}@${c}" ${tp})
    saved_offset(${dir}/state ${tp} got)
    if(limit STREQUAL "")
      want_offset("${ends}" ${c} want)
      if(want EQUAL 0)
        set(want "")
      endif()
      if(NOT "${got}" STREQUAL "${want}")
        hud_fail("${name}@${c}" "saved offset ${got}, expected ${want} (empty: no state saved)")
      endif()
    elseif(NOT got STREQUAL "" AND got GREATER limit)
      hud_fail("${name}@${c}" "saved offset ${got}, past ${limit}")
    endif()
  endforeach()
endfunction()

# Every terminator's surroundings, from just before it to one byte past it, plus the end; every third.
function(cut_points full ends out)
  file(SIZE ${full} len)
  set(all "")
  foreach(e IN LISTS ends)
    string(REPLACE "," ";" e "${e}")
    list(GET e 0 end)
    list(GET e 1 l)
    math(EXPR from "${end} - ${l}")
    math(EXPR to "${end} + 1")
    foreach(c RANGE ${from} ${to})
      if(c GREATER 0 AND NOT c GREATER len)
        list(APPEND all ${c})
      endif()
    endforeach()
  endforeach()
  list(APPEND all ${len})
  list(REMOVE_DUPLICATES all)
  list(SORT all COMPARE NATURAL)
  list(LENGTH all n)
  set(picked "")
  set(k 0)
  foreach(c IN LISTS all)
    math(EXPR r "${k} % 3")
    math(EXPR k "${k} + 1")
    if(r EQUAL 0 OR k EQUAL n)
      list(APPEND picked ${c})
    endif()
  endforeach()
  set(${out} "${picked}" PARENT_SCOPE)
endfunction()

# Overwrites <Needle> at <At> in <File> with <Replacement>, the same length; <At> must lie in
# [<Lo>, <Hi>), where the change tests what the step says it tests.
function(rewrite_at file at lo hi needle replacement)
  if(at LESS lo OR NOT at LESS hi)
    message(FATAL_ERROR "cache.cmake: ${needle} at ${at}, outside [${lo}, ${hi}): the step would not test what it says")
  endif()
  execute_process(COMMAND ${HUD_BYTES} splice ${file} ${at} ${replacement} COMMAND_ERROR_IS_FATAL ANY)
endfunction()

# Puts the bytes of <Full> back into <File>, in place, so the file keeps its identity.
function(restore full file)
  file(SIZE ${full} len)
  execute_process(COMMAND ${HUD_BYTES} cut ${file} 0 COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND ${HUD_BYTES} append ${full} ${file} 0 ${len} COMMAND_ERROR_IS_FATAL ANY)
endfunction()

foreach(mode lf crlf cr ls ps mixed)
  hud_selected(${mode} sel)
  if(sel)
    section(${mode})
    set(full ${dir}/full/${mode}.jsonl)
    build(${lines_file} ${mode} ${full} ends)
    cut_points(${full} "${ends}" cuts)
    grow(${mode} ${full} "${ends}" "${cuts}")
  endif()
endforeach()

set(read_needle [=["name":"Read"]=])
set(edit_needle [=["name":"Edit"]=])
set(read_other [=["name":"Gret"]=])
set(edit_other [=["name":"Edix"]=])
string(LENGTH "${read_needle}" needle_len)

hud_selected(invalidate sel)
if(sel)
  section(invalidate)
  set(full ${dir}/full/invalidate.jsonl)
  build(${lines_file} lf ${full} ends)
  file(READ ${full} t)
  file(SIZE ${full} len)
  set(tp ${dir}/t/invalidate.jsonl)
  file(WRITE ${tp} "")
  foreach(step first-bytes before-offset replaced shorter state-damaged state-cut)
    restore(${full} ${tp})
    check("invalidate/setup-${step}" ${tp})
    if(step STREQUAL "first-bytes")
      string(FIND "${t}" "${read_needle}" at)
      math(EXPR hi "4096 - ${needle_len}")
      rewrite_at(${tp} ${at} 0 ${hi} "${read_needle}" "${read_other}")
    elseif(step STREQUAL "before-offset")
      string(FIND "${t}" "${edit_needle}" at REVERSE)
      math(EXPR lo "${len} - 4096")
      if(lo LESS 4096)
        set(lo 4096)
      endif()
      rewrite_at(${tp} ${at} ${lo} ${len} "${edit_needle}" "${edit_other}")
    elseif(step STREQUAL "replaced")
      math(EXPR half "${len} / 2")
      string(SUBSTRING "${t}" ${half} -1 tail)
      string(FIND "${tail}" "${read_needle}" at)
      math(EXPR at "${at} + ${half}")
      file(COPY_FILE ${full} ${tp}.new)
      rewrite_at(${tp}.new ${at} 0 ${len} "${read_needle}" "${read_other}")
      file(RENAME ${tp}.new ${tp})
    elseif(step STREQUAL "shorter")
      math(EXPR half "${len} / 2")
      execute_process(COMMAND ${HUD_BYTES} cut ${tp} ${half} COMMAND_ERROR_IS_FATAL ANY)
    elseif(step STREQUAL "state-damaged")
      file(WRITE ${dir}/state/invalidate.bin "not a state")
    else()
      file(SIZE ${dir}/state/invalidate.bin size)
      math(EXPR size "${size} / 2")
      execute_process(COMMAND ${HUD_BYTES} cut ${dir}/state/invalidate.bin ${size} COMMAND_ERROR_IS_FATAL ANY)
    endif()
    check("invalidate/${step}" ${tp})
  endforeach()
endif()

hud_selected(replaced sel)
if(sel)
  section(replaced)
  string(REPEAT "f" 5000 f)
  lines_with(${dir}/lines.jsonl 0 "{\"type\":\"last-prompt\",\"lastPrompt\":\"${f}\",\"k\":1}"
                                999 "{\"type\":\"last-prompt\",\"lastPrompt\":\"${f}\",\"k\":2}")
  set(full ${dir}/full/replaced.jsonl)
  build(${dir}/lines.jsonl lf ${full} ends)
  file(READ ${full} t)
  file(SIZE ${full} len)
  grow(replaced ${full} "${ends}" ${len})
  set(tp ${dir}/t/replaced.jsonl)
  string(FIND "${t}" "${read_needle}" at)
  math(EXPR hi "${len} - 4096 - ${needle_len}")
  file(COPY_FILE ${full} ${tp}.new)
  rewrite_at(${tp}.new ${at} 4096 ${hi} "${read_needle}" "${read_other}")
  file(RENAME ${tp}.new ${tp})
  check("replaced/differing-between-windows" ${tp})
endif()

hud_selected(same-name sel)
if(sel)
  section(same-name)
  set(fa ${dir}/full/a.jsonl)
  set(fb ${dir}/full/b.jsonl)
  build(${lines_file} lf ${fa} ends)
  build(${lines_file} crlf ${fb} ends)
  set(pa ${dir}/t/one/same.jsonl)
  set(pb ${dir}/t/two/same.jsonl)
  file(MAKE_DIRECTORY ${dir}/t/one ${dir}/t/two)
  foreach(side a b)
    file(SIZE ${f${side}} len_${side})
    math(EXPR half_${side} "${len_${side}} / 2")
    file(WRITE ${p${side}} "")
    execute_process(COMMAND ${HUD_BYTES} append ${f${side}} ${p${side}} 0 ${half_${side}} COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  foreach(round 0 1 2)
    if(round EQUAL 1)
      foreach(side a b)
        execute_process(COMMAND ${HUD_BYTES} append ${f${side}} ${p${side}} ${half_${side}} ${len_${side}} COMMAND_ERROR_IS_FATAL ANY)
      endforeach()
    endif()
    check("same-name/first-round-${round}" ${pa})
    check("same-name/second-round-${round}" ${pb})
  endforeach()
endif()

hud_selected(unsupported sel)
if(sel)
  section(unsupported)
  lines_with(${dir}/lines.jsonl 2 [=[{"type":"user","timestamp":"October 10, 2026","message":{"content":"x"}}]=])
  set(full ${dir}/full/unsupported.jsonl)
  build(${dir}/lines.jsonl lf ${full} ends)
  file(SIZE ${full} len)
  math(EXPR half "${len} / 2")
  grow(unsupported ${full} "${ends}" "${half};${len}")
endif()

hud_selected(timeless sel)
if(sel)
  section(timeless)
  set(timeless_line [=[{"type":"assistant","message":{"id":"nt","content":[{"type":"tool_use","id":"toolu_nt","name":"Task","input":{"description":"no time"}}]}}]=])
  lines_with(${dir}/lines.jsonl 6 "${timeless_line}")
  set(full ${dir}/full/timeless.jsonl)
  build(${dir}/lines.jsonl lf ${full} ends)
  file(READ ${full} t)
  file(SIZE ${full} len)
  string(FIND "${t}" "${timeless_line}" start)
  math(EXPR a "${start} / 2")
  math(EXPR b "${start} + 10")
  grow(timeless ${full} "${ends}" "${a};${b};${len}" ${start})
endif()

hud_finish()
